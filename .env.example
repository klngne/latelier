# Required: point your domain's A/AAAA records to the server running Docker.
SITE_ADDRESS=atelier.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrateur
# Use a unique random password with at least 16 characters.
ADMIN_PASSWORD=CHANGE_ME
# Vercel only: provision Neon Postgres and Vercel Blob from the Vercel Marketplace.
# DATABASE_URL and BLOB_READ_WRITE_TOKEN are injected by those integrations.
